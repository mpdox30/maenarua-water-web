<script>
// ข้อมูลบัญชีน้ำรายวันทั้งหมด (ดึงจาก Excel ด้วย build_water_ledger_json.py แบบ manual -- ไม่ได้ผูกกับ
// data_pipeline.py อัตโนมัติ ดูหมายเหตุในหน้า)
const DATA_ENDPOINT = 'assets/data/water_ledger.json';

const THAI_MONTH = ["มกราคม","กุมภาพันธ์","มีนาคม","เมษายน","พฤษภาคม","มิถุนายน",
                     "กรกฎาคม","สิงหาคม","กันยายน","ตุลาคม","พฤศจิกายน","ธันวาคม"];

let ledger = null;

function fmtNum(n, digits) {
  if (n === null || n === undefined || Number.isNaN(n)) return '—';
  return Number(n).toLocaleString('en-US', { minimumFractionDigits: digits || 0, maximumFractionDigits: digits || 0 });
}
function fmtInt(n) { return fmtNum(n, 0); }
function fmtLevel(n) { return fmtNum(n, 3); }

function thaiMonthLabel(ym) {
  const [y, m] = ym.split('-').map(Number);
  return `${THAI_MONTH[m - 1]} ${y + 543}`;
}

function thaiDateLabel(iso) {
  const [y, m, d] = iso.split('-').map(Number);
  return `${d} ${THAI_MONTH[m - 1]} ${y + 543}`;
}

function populateMonthSelect() {
  const sel = document.getElementById('monthSelect');
  sel.innerHTML = ledger.months_available.map(ym =>
    `<option value="${ym}">${thaiMonthLabel(ym)}</option>`
  ).join('');
  // ค่าเริ่มต้น = เดือนล่าสุดที่มีข้อมูล
  sel.value = ledger.months_available[ledger.months_available.length - 1];
  sel.addEventListener('change', () => renderMonthTable(sel.value));
}

function renderMonthTable(ym) {
  const rows = ledger.rows.filter(r => `${String(r.year).padStart(4,'0')}-${String(r.month).padStart(2,'0')}` === ym);
  const tbody = document.getElementById('ledgerTableBody');
  if (!rows.length) {
    tbody.innerHTML = `<tr><td colspan="11" class="loading-note">ไม่มีข้อมูลในเดือนนี้</td></tr>`;
    document.getElementById('monthSummary').textContent = '';
    return;
  }
  tbody.innerHTML = rows.map(r => {
    return `
    <tr>
      <td>${thaiDateLabel(r.date)}</td>
      <td>${fmtLevel(r.water_level_m)}</td>
      <td>${fmtInt(r.water_volume_m3)}</td>
      <td class="hl">${fmtInt(r.inflow_m3)}</td>
      <td>${fmtInt(r.outlet_release_m3)}</td>
      <td class="${r.spill_m3 > 0 ? 'spill' : ''}">${fmtInt(r.spill_m3)}</td>
      <td>${fmtNum(r.rain_24h_mm, 1)}</td>
      <td>${fmtInt(r.runoff_m3)}</td>
      <td>${fmtInt(r.evap_m3)}</td>
      <td>${fmtInt(r.infiltration_m3)}</td>
      <td>${fmtInt(r.delta_s_m3)}</td>
    </tr>`;
  }).join('');

  const totalInflow = rows.reduce((s, r) => s + (r.inflow_m3 || 0), 0);
  const totalSpill = rows.reduce((s, r) => s + (r.spill_m3 || 0), 0);
  const totalRain = rows.reduce((s, r) => s + (r.rain_24h_mm || 0), 0);
  document.getElementById('monthSummary').innerHTML =
    `${rows.length} วัน · น้ำไหลเข้ารวม <strong>${fmtInt(totalInflow)}</strong> ลบ.ม. · ` +
    `ล้นสปิลเวย์รวม <strong>${fmtInt(totalSpill)}</strong> ลบ.ม. · ฝนสะสมรวม <strong>${fmtNum(totalRain,1)}</strong> มม.`;
}

function renderKPIs() {
  const rows = ledger.rows;
  const latest = rows[rows.length - 1];
  document.getElementById('kpiLatestDate').textContent = latest ? thaiDateLabel(latest.date) : '—';
  document.getElementById('kpiLatestLevel').innerHTML = latest ? `${fmtLevel(latest.water_level_m)}<span class="kpi-unit">ม.รทก.</span>` : '—';
  document.getElementById('kpiLatestVolumeNote').textContent = latest ? `ปริมาตรน้ำ: ${fmtInt(latest.water_volume_m3)} ลบ.ม.` : '—';
  document.getElementById('kpiLatestInflow').innerHTML = latest ? `${fmtInt(latest.inflow_m3)}<span class="kpi-unit">ลบ.ม./วัน</span>` : '—';
  document.getElementById('kpiLatestSpillNote').textContent = latest ? `ล้นทางระบายน้ำล้น: ${fmtInt(latest.spill_m3)} ลบ.ม.` : '—';
  document.getElementById('kpiMonthsCount').textContent = `${ledger.months_available.length} เดือน`;
  if (ledger.months_available.length) {
    const first = ledger.months_available[0];
    const last = ledger.months_available[ledger.months_available.length - 1];
    document.getElementById('kpiMonthsRange').textContent = `${thaiMonthLabel(first)} ถึง ${thaiMonthLabel(last)}`;
  }
}

fetch(DATA_ENDPOINT)
  .then(res => { if (!res.ok) throw new Error('HTTP ' + res.status); return res.json(); })
  .then(json => {
    ledger = json;
    document.getElementById('statusText').textContent =
      `โหลดข้อมูลสำเร็จ — ${ledger.rows.length} แถว จาก ${ledger.months_available.length} เดือน`;
    const first = ledger.months_available[0];
    const last = ledger.months_available[ledger.months_available.length - 1];
    document.getElementById('heroRangeTag').innerHTML =
      `<span class="dot" style="background:var(--teal-400)"></span>ข้อมูล ${thaiMonthLabel(first)} – ${thaiMonthLabel(last)}`;
    let genDate = '—';
    try { genDate = new Date(ledger.generated_at).toLocaleString('th-TH', { dateStyle: 'long', timeStyle: 'short', timeZone: 'Asia/Bangkok' }) + ' น.'; } catch (e) {}
    document.getElementById('heroGeneratedTag').innerHTML =
      `<span class="dot" style="background:var(--amber-400)"></span>สร้างไฟล์นี้เมื่อ ${genDate}`;
    document.getElementById('footerUpdated').textContent = `สร้างตารางบัญชีน้ำนี้เมื่อ ${genDate}`;
    renderKPIs();
    populateMonthSelect();
    renderMonthTable(ledger.months_available[ledger.months_available.length - 1]);
  })
  .catch(err => {
    document.getElementById('statusText').textContent = 'โหลดข้อมูลไม่สำเร็จ: ' + err.message;
    document.getElementById('ledgerTableBody').innerHTML =
      `<tr><td colspan="11" class="error-note">โหลด water_ledger.json ไม่สำเร็จ: ${err.message}</td></tr>`;
  });
</script>

